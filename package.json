{
  "name": "site-scanner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fingerprints": "node scripts/fetch-fingerprints.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "scan": "pnpm --filter @site-scanner/core scan",
    "hash-password": "node scripts/hash-password.mjs",
    "db:generate": "pnpm --filter @site-scanner/db generate",
    "dev:web": "pnpm --filter @site-scanner/web dev",
    "dev:worker": "pnpm --filter @site-scanner/worker dev"
  }
}
