# ---- required ----
PUBLIC_SITE_URL=https://scanner.example.com     # public URL; also used in the bot User-Agent
OWN_HOSTS=scanner.example.com                   # comma-separated hostnames of this deployment (never scanned)
POSTGRES_PASSWORD=change-me-long-random
SESSION_SECRET=change-me-64-random-chars         # openssl rand -hex 32
IP_HASH_SALT=change-me-64-random-chars           # openssl rand -hex 32
ADMIN_PASSWORD_HASH=                             # node scripts/hash-password.mjs '<password>' --totp

# ---- strongly recommended ----
ADMIN_TOTP_SECRET=                               # from the same command; add to your authenticator app
OWN_IPS=                                         # public IPv4/IPv6 of the VPS, comma-separated (hairpin protection)
TURNSTILE_SITE_KEY=                              # Cloudflare Turnstile (free) — human check on the scan form
TURNSTILE_SECRET_KEY=
ABUSE_CONTACT=you@example.com                    # shown on /bot and /privacy
BEHIND_CLOUDFLARE=true                           # trust CF-Connecting-IP (only with a Cloudflare-only firewall)

# ---- optional enrichment ----
GOOGLE_API_KEY=                                  # PageSpeed Insights + Safe Browsing (free; enable both APIs in Google Cloud)
SITE_NAME=Site Scanner
DENYLIST_EXTRA=                                  # extra suffixes to refuse, e.g. ".edu,.ac.uk"
SCAN_CONCURRENCY=2
BROWSER_ENABLED=true
PLAYWRIGHT_CHROMIUM_PATH=                        # optional: path to a system Chromium binary
SCREENSHOT_RETENTION_DAYS=90
IP_RETENTION_DAYS=30
MAX_QUEUE_DEPTH=20
LOG_LEVEL=info
