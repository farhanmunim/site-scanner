# ---- the only things you must set (Coolify → Environment Variables) ----
ADMIN_EMAIL=you@example.com          # also shown as the contact on /bot and /privacy
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password  # 8+ characters; 16+ recommended

# ---- recommended (free) ----
TURNSTILE_SITE_KEY=                  # Cloudflare Turnstile widget for your domain
TURNSTILE_SECRET_KEY=
GOOGLE_API_KEY=                      # PageSpeed Insights + Safe Browsing APIs enabled on the key

# ---- everything below is optional; Coolify fills SERVICE_* automatically ----
# PUBLIC_SITE_URL=https://scanner.example.com   # defaults to the domain you set on the web service
# OWN_IPS=1.2.3.4                               # your VPS public IPs, so the scanner never targets itself
# ADMIN_TOTP_SECRET=                            # base32 secret for an authenticator app (2FA)
# SITE_NAME=Site Scanner
# DENYLIST_EXTRA=.edu,.ac.uk
# SCAN_CONCURRENCY=2
# BROWSER_ENABLED=true
# PLAYWRIGHT_CHROMIUM_PATH=
# SCREENSHOT_RETENTION_DAYS=90
# IP_RETENTION_DAYS=30
# MAX_QUEUE_DEPTH=20
# BEHIND_CLOUDFLARE=true
# LOG_LEVEL=info
# Plain docker compose (not Coolify): also set these three
# SERVICE_PASSWORD_POSTGRES=   SERVICE_PASSWORD_SESSION=   SERVICE_PASSWORD_IPSALT=   SERVICE_URL_WEB=https://scanner.example.com
